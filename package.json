{
  "name": "mathematica-web-ports",
  "version": "0.1.12",
  "private": true,
  "description": "Browser ports of ten Wolfram Demonstrations (robot motion planning, rotations, probabilistic roadmaps, car paths, art gallery, p-norm unit balls, robot singularities). Static site: all computation runs in the browser.",
  "author": "Tico Hannan",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/ticohannan/mathematica-web-ports.git"
  },
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=firefox --project=chromium --project=webkit",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:headed": "playwright test --project=firefox --headed",
    "test:all": "vitest run && playwright test --project=firefox --project=chromium --project=webkit",
    "report": "playwright show-report test-output/html-report",
    "publish:tested": "node tools/publish-tested.mjs",
    "explore": "node tools/explore-motion.mjs",
    "compare:original": "node tools/compare-with-original.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "three": "0.186.1",
    "vitest": "5.0.3"
  }
}
