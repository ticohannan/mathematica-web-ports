# Text files are LF in the repository AND in every working copy (Windows included): the tests compare
# generated text with the files byte for byte. Only Windows batch files keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (never convert line endings)
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.zip binary
*.nb  binary
